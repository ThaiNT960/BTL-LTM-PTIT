<?xml version="1.0" encoding="UTF-8"?>
<project name="NumberGuessing" default="jar" basedir=".">
    <import file="nbproject/build-impl.xml"/>

    <target name="-pre-compile">
        <fail message="Cần chạy Ant bằng JDK 24 trở lên để dùng JavaFX 25.">
            <condition><not><javaversion atleast="24"/></not></condition>
        </fail>
    </target>

    <!-- NetBeans biên dịch mã; hai JAR chỉ chứa phần cần cho từng máy. -->
    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}/client"/>
        <mkdir dir="${dist.dir}/server"/>
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}"
             includes="client/**,common/**,assets/**,sound/**,resources/**">
            <manifest><attribute name="Main-Class" value="client.ClientApp"/></manifest>
        </jar>
        <jar destfile="${dist.dir}/server/NumberGuessingServer.jar" basedir="${build.classes.dir}"
             includes="server/**,common/**">
            <manifest>
                <attribute name="Main-Class" value="server.Server"/>
                <attribute name="Class-Path" value="lib/mysql-connector-j-9.0.0.jar"/>
            </manifest>
        </jar>
        <copy todir="${dist.dir}/client/lib"><fileset dir="lib/javafx" includes="*.jar"/></copy>
        <copy todir="${dist.dir}/server/lib"><fileset dir="lib/server" includes="*.jar"/></copy>
        <copy todir="${dist.dir}/client/config"><fileset dir="config" includes="client.properties"/></copy>
        <copy todir="${dist.dir}/server/config"><fileset dir="config" includes="server.properties"/></copy>
    </target>

</project>
